// Jaanch AI — Complete Database Schema (DBML)
// Generated from supabase/migrations/ — paste into https://dbdiagram.io
// 47 tables · 4 enums · 4 views · 44 with RLS
// Verified against live Supabase schema dump (2026-03-02)

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

Enum summary_section_type {
  parties
  subject_matter
  current_status
  key_issue
}

Enum summary_verification_decision {
  verified
  flagged
}

Enum activity_type {
  processing_complete
  processing_started
  processing_failed
  contradictions_found
  verification_needed
  matter_opened
}

Enum data_residency_region {
  default
  us
  eu
  asia
}

// ─────────────────────────────────────────────
// Core: Users & Matters
// ─────────────────────────────────────────────

Table users {
  id uuid [pk, note: 'FK → auth.users(id) ON DELETE CASCADE']
  email text [not null]
  full_name text
  avatar_url text
  created_at timestamptz [default: `now()`]
  last_login timestamptz

  Note: 'RLS enabled. Mirrors auth.users for app-level queries.'
}

Table matters {
  id uuid [pk, default: `gen_random_uuid()`]
  title text [not null]
  description text
  status text [not null, default: 'active', note: 'active|archived|closed']
  cause_title text
  practice_group varchar(100)
  data_residency data_residency_region [default: 'default']
  verification_mode text [default: 'advisory', note: 'advisory|required']
  analysis_mode varchar(20) [not null, default: 'deep_analysis', note: 'quick_scan|deep_analysis']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  deleted_at timestamptz

  Note: 'RLS enabled. Central entity — nearly every table FKs here.'
}

Table matter_attorneys {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  user_id uuid [not null]
  role text [not null, note: 'owner|editor|viewer']
  invited_by uuid
  invited_at timestamptz [default: `now()`]
  created_at timestamptz [default: `now()`]

  indexes {
    (matter_id, user_id) [unique]
  }

  Note: 'RLS enabled. Access control pivot — RLS policies check this table.'
}

Table user_preferences {
  user_id uuid [pk, note: 'FK → auth.users ON DELETE CASCADE']
  email_notifications_processing boolean [not null, default: true]
  email_notifications_verification boolean [not null, default: true]
  browser_notifications boolean [not null, default: false]
  theme varchar(10) [not null, default: 'system', note: 'light|dark|system']
  power_user_mode boolean [not null, default: false]
  onboarding_completed boolean [not null, default: false]
  onboarding_stage varchar(20) [note: 'dashboard|upload|settings|summary|...']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. One row per user.'
}

// ─────────────────────────────────────────────
// Documents & OCR
// ─────────────────────────────────────────────

Table documents {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  filename text [not null]
  storage_path text [not null]
  file_size bigint [not null]
  page_count integer
  document_type text [not null, note: 'case_file|act|annexure|other']
  is_reference_material boolean [default: false]
  uploaded_by uuid [note: 'nullable for auto_fetched/system']
  uploaded_at timestamptz [default: `now()`]
  status text [not null, default: 'pending', note: 'pending|processing|ocr_complete|ocr_failed|pending_review|chunking|chunking_failed|embedding|embedding_failed|searchable|completed|failed']
  processing_started_at timestamptz
  processing_completed_at timestamptz
  extracted_text text
  ocr_confidence float
  ocr_quality_score float
  ocr_error text
  ocr_retry_count integer [default: 0]
  validation_status text [default: 'pending', note: 'pending|validated|requires_human_review']
  ocr_confidence_per_page jsonb [default: '[]']
  ocr_quality_status text [note: 'good|fair|poor or NULL']
  deleted_at timestamptz
  source text [not null, default: 'user_upload', note: 'user_upload|auto_fetched|system']
  india_code_url text
  injection_risk text [default: 'none', note: 'none|low|medium|high']
  injection_scan_result jsonb
  migrated_to_library boolean [default: false]
  library_document_id uuid
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Central document record with OCR lifecycle tracking.'
}

Table document_ocr_chunks {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  document_id uuid [not null]
  chunk_index integer [not null, note: 'zero-indexed, CHECK >= 0']
  page_start integer [not null, note: '1-indexed, CHECK >= 1']
  page_end integer [not null, note: 'CHECK page_start <= page_end']
  status text [not null, default: 'pending', note: 'pending|processing|completed|failed']
  error_message text
  result_storage_path text
  result_checksum text [note: 'SHA256']
  ocr_full_text text [note: 'added for text merging']
  processing_started_at timestamptz
  processing_completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (document_id, chunk_index) [unique]
  }

  Note: 'RLS enabled. Tracks parallel OCR batches for large documents (>30 pages).'
}

Table ocr_validation_log {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null]
  bbox_id uuid [note: 'nullable — ON DELETE SET NULL']
  original_text text [not null]
  corrected_text text [not null]
  old_confidence float [note: 'CHECK 0-1']
  new_confidence float [note: 'CHECK 0-1']
  validation_type text [not null, note: 'pattern|gemini|human']
  reasoning text
  created_at timestamptz [default: `now()`]

  Note: 'RLS enabled. IMMUTABLE — SELECT+INSERT only. 7-year compliance audit trail.'
}

Table ocr_human_review {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null]
  matter_id uuid [not null]
  bbox_id uuid [note: 'nullable — ON DELETE SET NULL']
  original_text text [not null]
  context_before text
  context_after text
  page_number integer [not null, note: 'CHECK >= 1']
  status text [not null, default: 'pending', note: 'pending|completed|skipped']
  corrected_text text
  reviewed_by uuid
  reviewed_at timestamptz
  created_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Human-in-the-loop OCR correction queue.'
}

// ─────────────────────────────────────────────
// Chunks & Embeddings
// ─────────────────────────────────────────────

Table chunks {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  document_id uuid [not null]
  parent_chunk_id uuid [note: 'self-FK for parent/child hierarchy']
  chunk_index integer [not null]
  content text [not null]
  embedding vector_1536 [note: 'OpenAI text-embedding-3-small']
  embedding_voyage vector_1024 [note: 'Voyage AI voyage-law-2 for A/B testing']
  embedding_model_version text [default: 'text-embedding-3-small']
  entity_ids uuid_array
  page_number integer
  bbox_ids uuid_array
  token_count integer
  chunk_type text [not null, note: 'parent|child|table']
  layout_derived boolean [default: false]
  text_start_offset integer
  text_end_offset integer
  fts tsvector [note: 'GENERATED from content — GIN indexed']
  created_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Core retrieval unit. Dual embeddings for A/B testing.'
}

Table bounding_boxes {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  document_id uuid [not null]
  page_number integer [not null]
  x float [not null]
  y float [not null]
  width float [not null]
  height float [not null]
  text text [not null]
  confidence float
  reading_order_index integer [note: 'CHECK >= 0 or NULL']
  text_start_offset integer
  text_end_offset integer
  created_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Google Document AI bounding boxes for spatial search.'
}

Table document_tables {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null]
  matter_id uuid [not null]
  table_index integer [not null]
  page_number integer
  markdown_content text [not null]
  json_content jsonb
  row_count integer [not null, default: 0]
  col_count integer [not null, default: 0]
  confidence float [not null, default: 0.9]
  bounding_box jsonb
  caption text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (document_id, table_index) [unique]
  }

  Note: 'RLS enabled. Docling-extracted tables stored as markdown + JSON.'
}

Table section_index {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null]
  matter_id uuid [not null]
  section_number text [not null]
  page_number integer [not null]
  confidence float [default: 1.0]
  is_toc boolean [default: false]
  section_title text
  bbox_id uuid [note: 'ON DELETE SET NULL']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Maps section numbers to pages for citation verification.'
}

Table toc_pages {
  id uuid [pk, default: `gen_random_uuid()`]
  document_id uuid [not null]
  page_number integer [not null]
  confidence float [default: 1.0]
  detected_via text [default: 'manual']
  created_at timestamptz [default: `now()`]

  indexes {
    (document_id, page_number) [unique]
  }

  Note: 'RLS enabled. Marks table-of-contents pages to skip during extraction.'
}

// ─────────────────────────────────────────────
// Entities (Master Identity Graph)
// ─────────────────────────────────────────────

Table identity_nodes {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  canonical_name text [not null]
  entity_type text [not null, note: 'PERSON|ORG|INSTITUTION|ASSET']
  aliases text_array [default: '{}']
  metadata jsonb [default: '{}']
  mention_count integer [default: 0]
  merged_into_id uuid [note: 'self-FK — ON DELETE SET NULL']
  merged_at timestamptz
  merged_by uuid [note: 'FK → auth.users ON DELETE SET NULL']
  pre_merge_mention_count integer
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (matter_id, entity_type, canonical_name) [unique]
  }

  Note: 'RLS enabled. Canonical entities with alias tracking and merge support.'
}

Table identity_edges {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  source_node_id uuid [not null]
  target_node_id uuid [not null]
  relationship_type text [not null, note: 'ALIAS_OF|HAS_ROLE|RELATED_TO']
  metadata jsonb [default: '{}']
  confidence float [note: 'CHECK 0-1']
  created_at timestamptz [default: `now()`]

  indexes {
    (matter_id, source_node_id, target_node_id, relationship_type) [unique]
  }

  Note: 'RLS enabled. Entity relationship graph edges.'
}

Table entity_mentions {
  id uuid [pk, default: `gen_random_uuid()`]
  entity_id uuid [not null]
  document_id uuid [not null]
  chunk_id uuid [note: 'ON DELETE SET NULL']
  page_number integer
  bbox_ids uuid_array [default: '{}']
  mention_text text [not null]
  context text
  confidence float [note: 'CHECK 0-1']
  created_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Every occurrence of an entity in source documents.'
}

Table alias_corrections {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  entity_id uuid [not null]
  correction_type text [not null, note: 'add|remove|merge']
  alias_name text
  merged_entity_id uuid [note: 'ON DELETE SET NULL']
  merged_entity_name text [note: 'preserved since entity may be deleted']
  original_confidence float
  corrected_by uuid [not null]
  reason text
  metadata jsonb [default: '{}']
  created_at timestamptz [not null, default: `now()`]

  Note: 'RLS enabled. IMMUTABLE — no UPDATE/DELETE. Audit trail for entity corrections.'
}

// ─────────────────────────────────────────────
// Citations & Acts
// ─────────────────────────────────────────────

Table citations {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  source_document_id uuid [not null]
  act_name text [not null]
  act_name_original text
  section text [not null]
  subsection text
  clause text
  quoted_text text
  raw_citation_text text
  source_page integer [not null]
  source_bbox_ids uuid_array
  verification_status text [not null, default: 'pending', note: 'verified|mismatch|not_found|act_unavailable|pending']
  target_act_document_id uuid [note: 'FK → library_documents ON DELETE SET NULL']
  target_page integer
  target_bbox_ids uuid_array
  confidence float [note: 'CHECK 0-1']
  mismatch_details jsonb
  extraction_metadata jsonb
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Legal citations extracted from documents, verified against library acts.'
}

Table act_resolutions {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  act_name_normalized text [not null]
  act_name_display text
  act_document_id uuid [note: 'FK → library_documents ON DELETE SET NULL']
  resolution_status text [not null, default: 'missing', note: 'available|auto_fetched|auto_fetching|missing|invalid|not_on_indiacode|skipped']
  user_action text [not null, default: 'pending', note: 'uploaded|skipped|auto_fetched|pending']
  citation_count integer [default: 0]
  is_valid boolean [default: true]
  validation_cache_id uuid
  first_seen_at timestamptz [default: `now()`]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    (matter_id, act_name_normalized) [unique]
  }

  Note: 'RLS enabled. Tracks which acts are cited and whether they are available.'
}

Table act_validation_cache {
  id uuid [pk, default: `gen_random_uuid()`]
  act_name_normalized text [not null, unique]
  act_name_canonical text
  act_year integer
  india_code_url text
  india_code_doc_id text
  validation_status text [not null, default: 'unknown', note: 'valid|invalid|state_act|not_on_indiacode|unknown']
  cached_storage_path text
  validation_source text
  validation_confidence float
  validation_metadata jsonb
  last_validated_at timestamptz [default: `now()`]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled (read-only for users). Global cache — shared across matters.'
}

// ─────────────────────────────────────────────
// Timeline & Events
// ─────────────────────────────────────────────

Table events {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  document_id uuid [note: 'ON DELETE SET NULL']
  event_date date [not null]
  event_date_precision text [not null, default: 'day', note: 'day|month|year|approximate']
  event_date_text text
  event_type text [not null]
  description text [not null]
  entities_involved uuid_array
  source_page integer
  source_bbox_ids uuid_array
  confidence float [note: 'CHECK 0-1']
  is_manual boolean [default: false]
  created_by uuid
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Timeline events extracted from documents or manually added.'
}

Table anomalies {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  anomaly_type text [not null, note: 'gap|sequence_violation|duplicate|outlier']
  severity text [not null, note: 'low|medium|high|critical']
  title text [not null]
  explanation text [not null]
  event_ids uuid_array [not null]
  expected_order text_array
  actual_order text_array
  gap_days integer
  confidence float [default: 0.8, note: 'CHECK 0-1']
  verified boolean [default: false]
  dismissed boolean [default: false]
  verified_by uuid
  verified_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Timeline anomalies: gaps, sequence violations, duplicates.'
}

// ─────────────────────────────────────────────
// Contradictions
// ─────────────────────────────────────────────

Table statement_comparisons {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  entity_id uuid [not null]
  statement_a_id uuid [not null]
  statement_b_id uuid [not null]
  result varchar(20) [not null, note: 'contradiction|consistent|uncertain|unrelated']
  confidence numeric [not null, note: 'CHECK 0-1']
  reasoning text [not null]
  evidence jsonb [default: '{}']
  contradiction_type varchar(30) [note: 'semantic_contradiction|factual_contradiction|date_mismatch|amount_mismatch']
  severity varchar(10) [note: 'high|medium|low']
  severity_reasoning text
  explanation text
  extracted_values jsonb [default: '{}']
  source_document_id uuid [note: 'ON DELETE SET NULL']
  input_tokens integer
  output_tokens integer
  cost_usd numeric [note: 'numeric(10,6)']
  created_at timestamptz [default: `now()`]

  indexes {
    (matter_id, statement_a_id, statement_b_id) [unique]
  }

  Note: 'RLS enabled. Pairwise statement contradiction analysis results.'
}

// ─────────────────────────────────────────────
// Findings & Verification
// ─────────────────────────────────────────────

Table findings {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  engine_type text [not null, note: 'citation|timeline|contradiction']
  finding_type text [not null]
  content jsonb [not null]
  confidence float [not null, note: 'CHECK 0-1']
  evidence_refs jsonb
  source_document_ids uuid_array
  source_pages integer_array
  source_bbox_ids uuid_array
  status text [not null, default: 'pending', note: 'pending|verified|rejected']
  verified_by uuid
  verified_at timestamptz
  verification_notes text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Unified findings from all analysis engines.'
}

Table finding_verifications {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  finding_id uuid [note: 'ON DELETE SET NULL — preserved if finding deleted']
  finding_type text [not null]
  finding_summary text [not null]
  confidence_before float [not null, note: 'CHECK 0-100 — original AI confidence']
  decision text [not null, default: 'pending', note: 'pending|approved|rejected|flagged']
  verified_by uuid
  verified_at timestamptz
  confidence_after float [note: 'CHECK 0-100 — attorney-adjusted']
  notes text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Tiered verification: >90% optional, 70-90% suggested, <70% required.'
}

// ─────────────────────────────────────────────
// Summary
// ─────────────────────────────────────────────

Table summary_verifications {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  section_type summary_section_type [not null]
  section_id text [not null]
  decision summary_verification_decision [not null]
  notes text
  verified_by uuid [not null]
  verified_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (matter_id, section_type, section_id) [unique]
  }

  Note: 'RLS enabled. Attorney verification of AI-generated summary sections.'
}

Table summary_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  section_type summary_section_type [not null]
  section_id text [not null]
  text text [not null, note: 'CHECK LENGTH(TRIM(text)) > 0']
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'RLS enabled. Multiple notes per section allowed.'
}

Table summary_edits {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  section_type summary_section_type [not null]
  section_id text [not null]
  original_content text [not null]
  edited_content text [not null]
  edited_by uuid [not null]
  edited_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (matter_id, section_type, section_id) [unique]
  }

  Note: 'RLS enabled. Upsert pattern — one edit per section.'
}

// ─────────────────────────────────────────────
// Processing & Jobs
// ─────────────────────────────────────────────

Table processing_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  document_id uuid [note: 'ON DELETE CASCADE']
  job_type text [not null, note: 'DOCUMENT_PROCESSING|OCR|VALIDATION|CHUNKING|EMBEDDING|ENTITY_EXTRACTION|ALIAS_RESOLUTION|CITATION_EXTRACTION|CITATION_VERIFICATION|CONTRADICTION_DETECTION|DATE_EXTRACTION|EVENT_CLASSIFICATION|ENTITY_LINKING|ANOMALY_DETECTION|SUMMARY_GENERATION']
  status text [not null, default: 'QUEUED', note: 'QUEUED|PROCESSING|COMPLETED|FAILED|CANCELLED|SKIPPED']
  celery_task_id text
  current_stage text
  total_stages integer [default: 7]
  completed_stages integer [default: 0]
  progress_pct integer [default: 0, note: 'CHECK 0-100']
  estimated_completion timestamptz
  error_message text
  error_code text
  retry_count integer [default: 0]
  max_retries integer [default: 3]
  metadata jsonb [default: '{}']
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Celery job tracking with stage-level progress.'
}

Table job_stage_history {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null]
  stage_name text [not null]
  status text [not null, default: 'PENDING', note: 'PENDING|IN_PROGRESS|COMPLETED|FAILED|SKIPPED']
  started_at timestamptz
  completed_at timestamptz
  error_message text
  metadata jsonb [default: '{}']
  created_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Granular stage-by-stage history for each job.'
}

// ─────────────────────────────────────────────
// Memory & Query History
// ─────────────────────────────────────────────

Table matter_memory {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  memory_type text [not null, note: 'query_history|timeline_cache|entity_graph|key_findings|research_notes|archived_session']
  data jsonb [not null, default: '{}']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Partial unique on (matter_id, memory_type) WHERE != archived_session.'
}

Table matter_query_history {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  query_id uuid [not null]
  audit_data jsonb [not null, note: 'full QueryAuditEntry — question, engines, costs, findings']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (matter_id, query_id) [unique]
  }

  Note: 'RLS enabled. APPEND-ONLY — no UPDATE/DELETE. Forensic query audit trail.'
}

// ─────────────────────────────────────────────
// Activity & Notifications
// ─────────────────────────────────────────────

Table activities {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  matter_id uuid [note: 'nullable for non-matter activities']
  type activity_type [not null]
  description text [not null]
  metadata jsonb [default: '{}']
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Note: 'RLS enabled. Per-user activity feed aggregated across matters.'
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  matter_id uuid [note: 'nullable for non-matter notifications']
  type text [not null, note: 'success|info|warning|error|in_progress']
  title text [not null]
  message text [not null]
  priority text [not null, default: 'medium', note: 'high|medium|low']
  is_read boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  Note: 'RLS enabled. In-app notification system.'
}

// ─────────────────────────────────────────────
// Exports
// ─────────────────────────────────────────────

Table exports {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  format text [not null, note: 'pdf|docx|pptx']
  status text [not null, default: 'pending', note: 'pending|processing|completed|failed']
  sections jsonb
  file_name text
  file_path text
  download_url text
  created_by uuid
  created_at timestamptz [default: `now()`]
  completed_at timestamptz
  error_message text
  verification_summary jsonb [note: 'snapshot of verification status at export time']

  Note: 'RLS enabled. Export jobs with generated file tracking.'
}

// ─────────────────────────────────────────────
// Library (Shared Acts & Statutes)
// ─────────────────────────────────────────────

Table library_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  filename text [not null]
  storage_path text [not null, unique]
  file_size bigint [not null]
  page_count integer
  document_type text [not null, note: 'act|statute|judgment|regulation|commentary|circular']
  title text [not null]
  short_title text
  year integer
  jurisdiction text
  source text [not null, default: 'user_upload', note: 'user_upload|india_code|manual_import']
  source_url text
  status text [not null, default: 'pending', note: 'pending|processing|completed|failed']
  processing_started_at timestamptz
  processing_completed_at timestamptz
  quality_flags jsonb [default: '[]']
  added_by uuid
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Global shared library — acts, statutes, judgments.'
}

Table library_chunks {
  id uuid [pk, default: `gen_random_uuid()`]
  library_document_id uuid [not null]
  chunk_index integer [not null]
  parent_chunk_id uuid [note: 'self-FK ON DELETE CASCADE']
  content text [not null]
  embedding vector_1536
  embedding_voyage vector_1024 [note: 'Voyage AI for A/B testing']
  page_number integer
  section_title text
  token_count integer
  chunk_type text [not null, note: 'parent|child|table']
  created_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Library document chunks with dual embeddings.'
}

Table matter_library_links {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  library_document_id uuid [not null]
  linked_by uuid [not null]
  linked_at timestamptz [default: `now()`]

  indexes {
    (matter_id, library_document_id) [unique]
  }

  Note: 'RLS enabled. Links library documents to specific matters.'
}

// ─────────────────────────────────────────────
// Evaluation & A/B Testing
// ─────────────────────────────────────────────

Table golden_dataset {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  question text [not null]
  expected_answer text [not null]
  relevant_chunk_ids uuid_array [default: '{}']
  tags text_array [default: '{}']
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'RLS enabled. Ground truth Q&A pairs for RAG evaluation.'
}

Table evaluation_results {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  golden_item_id uuid [note: 'ON DELETE SET NULL']
  question text [not null]
  answer text [not null]
  expected_answer text
  contexts text_array [default: '{}']
  context_recall float [note: 'RAGAS — CHECK 0-1']
  faithfulness float [note: 'RAGAS — CHECK 0-1']
  answer_relevancy float [note: 'RAGAS — CHECK 0-1']
  overall_score float [not null, note: 'CHECK 0-1']
  evaluated_at timestamptz [not null, default: `now()`]
  triggered_by text [not null, default: 'manual']
  job_id text [note: 'Celery task ID for batch grouping']
  chat_message_id text
  metric_scores jsonb [not null, default: '{}']
  pipeline_config jsonb [not null, default: '{}']
  embedding_provider text [default: 'openai']
  rerank_provider text [default: 'cohere']
  search_latency_ms integer

  Note: 'RLS enabled. RAGAS evaluation scores per query. Partial unique on (job_id, golden_item_id).'
}

Table ab_test_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  status text [not null, default: 'pending', note: 'pending|running_control|running_treatment|comparing|completed|failed|cancelled']
  control_embedding text [not null, default: 'openai']
  control_reranker text [not null, default: 'cohere']
  treatment_embedding text [not null, default: 'voyage']
  treatment_reranker text [not null, default: 'voyage']
  control_job_id text
  treatment_job_id text
  control_scores jsonb
  treatment_scores jsonb
  control_latency_p50_ms integer
  control_latency_p95_ms integer
  treatment_latency_p50_ms integer
  treatment_latency_p95_ms integer
  control_cost_usd numeric [default: 0]
  treatment_cost_usd numeric [default: 0]
  decision text [note: 'control_wins|treatment_wins|no_significant_difference|insufficient_data']
  decision_confidence float
  decision_reasoning text
  statistical_test jsonb
  golden_item_count integer
  tags text_array [default: '{}']
  error_message text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  Note: 'RLS enabled. A/B test runs comparing RAG pipeline configurations.'
}

Table evaluation_baselines {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  avg_overall float [not null, note: 'CHECK 0-1']
  avg_faithfulness float [note: 'CHECK 0-1']
  avg_relevancy float [note: 'CHECK 0-1']
  avg_recall float [note: 'CHECK 0-1']
  per_item_scores jsonb [not null, default: '{}']
  total_items integer [not null, default: 0]
  successful_items integer [not null, default: 0]
  promoted_from_job_id text
  pipeline_config jsonb [not null, default: '{}']
  created_by text
  created_at timestamptz [not null, default: `now()`]
  is_active boolean [not null, default: true]

  Note: 'RLS enabled. Baseline scores for regression detection in A/B testing.'
}

// ─────────────────────────────────────────────
// Cost Tracking & Quotas
// ─────────────────────────────────────────────

Table llm_costs {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [note: 'nullable — ON DELETE SET NULL (preserves historical data)']
  document_id uuid [note: 'nullable — ON DELETE SET NULL']
  entity_id uuid
  provider varchar(100) [not null]
  operation varchar(100) [not null]
  input_tokens integer [not null, default: 0]
  output_tokens integer [not null, default: 0]
  input_cost_inr numeric [not null, default: 0, note: 'numeric(12,4) — primary currency']
  output_cost_inr numeric [not null, default: 0]
  total_cost_inr numeric [not null, default: 0]
  input_cost_usd numeric [not null, default: 0, note: 'numeric(10,8) — reference']
  output_cost_usd numeric [not null, default: 0]
  total_cost_usd numeric [not null, default: 0]
  usd_to_inr_rate numeric [default: 83.50]
  duration_ms integer
  metadata jsonb [default: '{}']
  user_id uuid [note: 'FK → auth.users']
  created_at timestamptz [default: `now()`]

  Note: 'RLS enabled. Per-API-call LLM cost tracking. INR is primary currency.'
}

Table llm_pricing {
  id uuid [pk, default: `gen_random_uuid()`]
  provider varchar [not null]
  input_cost_per_1k numeric [not null]
  output_cost_per_1k numeric [not null]
  unit varchar [not null, default: 'tokens']
  effective_from timestamptz [not null, default: `now()`]
  effective_to timestamptz [note: 'nullable — NULL means current pricing']
  notes text
  created_at timestamptz [not null, default: `now()`]

  Note: 'RLS enabled. LLM pricing tiers — supports time-windowed pricing changes.'
}

Table llm_quota_limits {
  id uuid [pk, default: `gen_random_uuid()`]
  provider varchar(50) [not null, unique]
  daily_token_limit bigint
  monthly_token_limit bigint
  daily_cost_limit_inr numeric [note: 'numeric(12,4)']
  monthly_cost_limit_inr numeric [note: 'numeric(12,4)']
  alert_threshold_pct integer [not null, default: 80]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'RLS enabled. Global provider quota limits and alert thresholds.'
}

// ─────────────────────────────────────────────
// Audit & Reasoning
// ─────────────────────────────────────────────

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  event_type text [not null]
  user_id uuid [note: 'nullable — ON DELETE SET NULL']
  matter_id uuid [note: 'nullable — ON DELETE SET NULL']
  action text [not null]
  result text [not null, note: 'success|denied|error|blocked']
  ip_address inet
  user_agent text
  path text
  method text
  details jsonb
  created_at timestamptz [default: `now()`]

  Note: '⚠️ NO RLS — service role only. Immutable security audit trail.'
}

Table reasoning_traces {
  id uuid [pk, default: `gen_random_uuid()`]
  matter_id uuid [not null]
  finding_id uuid [note: 'ON DELETE SET NULL']
  engine_type text [not null, note: 'citation|timeline|contradiction|rag|entity']
  model_used text [not null]
  reasoning_text text [not null, note: 'CHECK length > 0']
  reasoning_structured jsonb
  input_summary text
  prompt_template_version text
  confidence_score float [note: 'CHECK 0-1']
  tokens_used integer
  cost_usd numeric [note: 'numeric(10,6)']
  created_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  archive_path text [note: 'Supabase Storage path for cold storage']

  Note: 'RLS enabled. IMMUTABLE — no UPDATE/DELETE. LLM chain-of-thought audit.'
}

// ─────────────────────────────────────────────
// Relationships
// ─────────────────────────────────────────────

// Users & Matters
Ref: matter_attorneys.matter_id > matters.id [delete: cascade]
Ref: matter_attorneys.user_id > users.id [delete: cascade]
Ref: matter_attorneys.invited_by > users.id
Ref: user_preferences.user_id > users.id [delete: cascade]

// Documents
Ref: documents.matter_id > matters.id [delete: cascade]
Ref: documents.uploaded_by > users.id
Ref: documents.library_document_id > library_documents.id [delete: set null]
Ref: document_ocr_chunks.matter_id > matters.id [delete: cascade]
Ref: document_ocr_chunks.document_id > documents.id [delete: cascade]

// OCR
Ref: ocr_validation_log.document_id > documents.id [delete: cascade]
Ref: ocr_validation_log.bbox_id > bounding_boxes.id [delete: set null]
Ref: ocr_human_review.document_id > documents.id [delete: cascade]
Ref: ocr_human_review.matter_id > matters.id [delete: cascade]
Ref: ocr_human_review.bbox_id > bounding_boxes.id [delete: set null]
Ref: ocr_human_review.reviewed_by > users.id

// Chunks
Ref: chunks.matter_id > matters.id [delete: cascade]
Ref: chunks.document_id > documents.id [delete: cascade]
Ref: chunks.parent_chunk_id > chunks.id [delete: cascade]

// Bounding Boxes
Ref: bounding_boxes.matter_id > matters.id [delete: cascade]
Ref: bounding_boxes.document_id > documents.id [delete: cascade]

// Tables
Ref: document_tables.document_id > documents.id [delete: cascade]
Ref: document_tables.matter_id > matters.id [delete: cascade]

// Section Index
Ref: section_index.document_id > documents.id [delete: cascade]
Ref: section_index.matter_id > matters.id [delete: cascade]
Ref: section_index.bbox_id > bounding_boxes.id [delete: set null]
Ref: toc_pages.document_id > documents.id [delete: cascade]

// Entities
Ref: identity_nodes.matter_id > matters.id [delete: cascade]
Ref: identity_nodes.merged_into_id > identity_nodes.id [delete: set null]
Ref: identity_nodes.merged_by > users.id [delete: set null]
Ref: identity_edges.matter_id > matters.id [delete: cascade]
Ref: identity_edges.source_node_id > identity_nodes.id [delete: cascade]
Ref: identity_edges.target_node_id > identity_nodes.id [delete: cascade]
Ref: entity_mentions.entity_id > identity_nodes.id [delete: cascade]
Ref: entity_mentions.document_id > documents.id [delete: cascade]
Ref: entity_mentions.chunk_id > chunks.id [delete: set null]
Ref: alias_corrections.matter_id > matters.id [delete: cascade]
Ref: alias_corrections.entity_id > identity_nodes.id [delete: cascade]
Ref: alias_corrections.merged_entity_id > identity_nodes.id [delete: set null]
Ref: alias_corrections.corrected_by > users.id

// Citations & Acts
Ref: citations.matter_id > matters.id [delete: cascade]
Ref: citations.source_document_id > documents.id [delete: cascade]
Ref: citations.target_act_document_id > library_documents.id [delete: set null]
Ref: act_resolutions.matter_id > matters.id [delete: cascade]
Ref: act_resolutions.act_document_id > library_documents.id [delete: set null]
Ref: act_resolutions.validation_cache_id > act_validation_cache.id

// Events
Ref: events.matter_id > matters.id [delete: cascade]
Ref: events.document_id > documents.id [delete: set null]
Ref: events.created_by > users.id
Ref: anomalies.matter_id > matters.id [delete: cascade]
Ref: anomalies.verified_by > users.id

// Contradictions
Ref: statement_comparisons.matter_id > matters.id [delete: cascade]
Ref: statement_comparisons.entity_id > identity_nodes.id [delete: cascade]
Ref: statement_comparisons.statement_a_id > chunks.id [delete: cascade]
Ref: statement_comparisons.statement_b_id > chunks.id [delete: cascade]
Ref: statement_comparisons.source_document_id > documents.id [delete: set null]

// Findings
Ref: findings.matter_id > matters.id [delete: cascade]
Ref: findings.verified_by > users.id
Ref: finding_verifications.matter_id > matters.id [delete: cascade]
Ref: finding_verifications.finding_id > findings.id [delete: set null]
Ref: finding_verifications.verified_by > users.id

// Summary
Ref: summary_verifications.matter_id > matters.id [delete: cascade]
Ref: summary_verifications.verified_by > users.id
Ref: summary_notes.matter_id > matters.id [delete: cascade]
Ref: summary_notes.created_by > users.id
Ref: summary_edits.matter_id > matters.id [delete: cascade]
Ref: summary_edits.edited_by > users.id

// Jobs
Ref: processing_jobs.matter_id > matters.id [delete: cascade]
Ref: processing_jobs.document_id > documents.id [delete: cascade]
Ref: job_stage_history.job_id > processing_jobs.id [delete: cascade]

// Memory
Ref: matter_memory.matter_id > matters.id [delete: cascade]
Ref: matter_query_history.matter_id > matters.id [delete: cascade]

// Activity & Notifications
Ref: activities.user_id > users.id [delete: cascade]
Ref: activities.matter_id > matters.id [delete: cascade]
Ref: notifications.user_id > users.id [delete: cascade]
Ref: notifications.matter_id > matters.id [delete: cascade]

// Exports
Ref: exports.matter_id > matters.id [delete: cascade]
Ref: exports.created_by > users.id

// Library
Ref: library_documents.added_by > users.id
Ref: library_chunks.library_document_id > library_documents.id [delete: cascade]
Ref: library_chunks.parent_chunk_id > library_chunks.id [delete: cascade]
Ref: matter_library_links.matter_id > matters.id [delete: cascade]
Ref: matter_library_links.library_document_id > library_documents.id [delete: cascade]
Ref: matter_library_links.linked_by > users.id

// Evaluation
Ref: golden_dataset.matter_id > matters.id [delete: cascade]
Ref: golden_dataset.created_by > users.id
Ref: evaluation_results.matter_id > matters.id [delete: cascade]
Ref: evaluation_results.golden_item_id > golden_dataset.id [delete: set null]
Ref: ab_test_runs.matter_id > matters.id [delete: cascade]
Ref: evaluation_baselines.matter_id > matters.id [delete: cascade]

// Costs
Ref: llm_costs.matter_id > matters.id [delete: set null]
Ref: llm_costs.document_id > documents.id [delete: set null]
Ref: llm_costs.user_id > users.id

// Audit
Ref: audit_logs.user_id > users.id [delete: set null]
Ref: audit_logs.matter_id > matters.id [delete: set null]
Ref: reasoning_traces.matter_id > matters.id [delete: cascade]
Ref: reasoning_traces.finding_id > findings.id [delete: set null]

// ─────────────────────────────────────────────
// Table Groups (visual organization in dbdiagram.io)
// ─────────────────────────────────────────────

TableGroup core {
  users
  matters
  matter_attorneys
  user_preferences
}

TableGroup documents_ocr {
  documents
  document_ocr_chunks
  bounding_boxes
  document_tables
  section_index
  toc_pages
  ocr_validation_log
  ocr_human_review
}

TableGroup chunks_embeddings {
  chunks
  library_chunks
}

TableGroup entities {
  identity_nodes
  identity_edges
  entity_mentions
  alias_corrections
}

TableGroup citations_acts {
  citations
  act_resolutions
  act_validation_cache
}

TableGroup timeline {
  events
  anomalies
}

TableGroup contradictions {
  statement_comparisons
}

TableGroup findings_verification {
  findings
  finding_verifications
  summary_verifications
  summary_notes
  summary_edits
}

TableGroup processing {
  processing_jobs
  job_stage_history
}

TableGroup memory {
  matter_memory
  matter_query_history
}

TableGroup activity_notifications {
  activities
  notifications
  exports
}

TableGroup library {
  library_documents
  library_chunks
  matter_library_links
}

TableGroup evaluation {
  golden_dataset
  evaluation_results
  ab_test_runs
  evaluation_baselines
}

TableGroup costs_audit {
  llm_costs
  llm_pricing
  llm_quota_limits
  audit_logs
  reasoning_traces
}
